{
  "name": "caldera-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && vitest run",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test:e2e": "pnpm -r build && CALDERA_E2E=1 vitest run packages/create-caldera"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@libsql/client": "0.18.0",
    "@types/node": "^24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
