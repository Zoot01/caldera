{
  "name": "@caldera/notifications",
  "version": "0.0.0",
  "description": "Caldera notifications: one notification over mail, the database and your own channels, sent now or one job per channel.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@caldera/db": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@caldera/db": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera/db": "workspace:*",
    "@caldera/mail": "workspace:*",
    "@caldera/queue": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "@libsql/client": "0.18.0",
    "@react-email/components": "1.0.12",
    "@types/react": "19.3.0",
    "drizzle-orm": "1.0.0-rc.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "zod": "^4.6.7",
    "pg": "8.23.1",
    "@types/pg": "^8.15.0"
  }
}
