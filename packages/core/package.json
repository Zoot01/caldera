{
  "name": "@caldera-js/core",
  "version": "0.0.0",
  "description": "Caldera application core: env, config, providers and the app lifecycle.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://calderajs.dev/docs/structure",
  "keywords": [
    "caldera",
    "framework",
    "typescript",
    "hono",
    "laravel"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
