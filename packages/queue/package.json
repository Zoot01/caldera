{
  "name": "@caldera-js/queue",
  "version": "0.0.0",
  "description": "Caldera queues: typed jobs with retries, backoff, timeouts, uniqueness, chains and batches, on the database, Redis (BullMQ), Cloudflare Queues, QStash, or right after the response.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://calderajs.dev/docs/queues",
  "keywords": [
    "caldera",
    "framework",
    "typescript",
    "hono",
    "laravel",
    "queue"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq.d.ts",
      "default": "./dist/bullmq.js"
    },
    "./qstash": {
      "types": "./dist/qstash.d.ts",
      "default": "./dist/qstash.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@caldera-js/db": "workspace:*",
    "@upstash/qstash": "^2.12.0",
    "bullmq": ">=5.0.0",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.0",
    "ioredis": ">=5.0.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@caldera-js/db": {
      "optional": true
    },
    "@upstash/qstash": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera-js/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera-js/cache": "workspace:*",
    "@caldera-js/db": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "0.18.0",
    "@types/pg": "^8.15.0",
    "@upstash/qstash": "2.12.1",
    "@upstash/qstash-cli": "2.40.12",
    "bullmq": "6.5.1",
    "drizzle-orm": "1.0.0-rc.5",
    "esbuild": "0.28.2",
    "hono": "^4.13.14",
    "ioredis": "6.0.0",
    "miniflare": "4.20260730.0",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
