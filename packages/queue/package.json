{
  "name": "@caldera/queue",
  "version": "0.0.0",
  "description": "Caldera queues: typed jobs with retries, backoff, timeouts, uniqueness and chains over sync, memory and BullMQ.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq.d.ts",
      "default": "./dist/bullmq.js"
    },
    "./qstash": {
      "types": "./dist/qstash.d.ts",
      "default": "./dist/qstash.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@upstash/qstash": "^2.12.0",
    "bullmq": ">=5.0.0",
    "hono": "^4.13.0",
    "ioredis": ">=5.0.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@upstash/qstash": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera/cache": "workspace:*",
    "@caldera/db": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "@hono/node-server": "^2.1.5",
    "@upstash/qstash": "2.12.1",
    "@upstash/qstash-cli": "2.40.12",
    "bullmq": "6.5.1",
    "drizzle-orm": "1.0.0-rc.5",
    "esbuild": "0.28.2",
    "hono": "^4.13.14",
    "ioredis": "6.0.0",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  }
}
