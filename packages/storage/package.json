{
  "name": "@caldera-js/storage",
  "version": "0.1.0",
  "description": "Caldera file storage: disks (local, S3, R2), signed links, uploads checked by their bytes, and direct uploads to a bucket.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://calderajs.dev/docs/storage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoot01/caldera.git",
    "directory": "packages/storage"
  },
  "bugs": "https://github.com/Zoot01/caldera/issues",
  "author": "Zoot01",
  "keywords": [
    "caldera",
    "framework",
    "typescript",
    "hono",
    "laravel",
    "storage"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "default": "./dist/s3.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.0",
    "react": ">=19.0.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "aws4fetch": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera-js/core": "workspace:*",
    "file-type": "21.3.4"
  },
  "devDependencies": {
    "@caldera-js/db": "workspace:*",
    "@caldera-js/http": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "@libsql/client": "0.18.0",
    "@types/react": "19.3.0",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "1.0.0-rc.5",
    "esbuild": "0.28.2",
    "hono": "^4.13.14",
    "miniflare": "4.20260730.0",
    "react": "19.3.1",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
