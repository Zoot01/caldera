{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    // `@/components/ui/button` is resources/components/ui/button.tsx (as in vite.config.ts and components.json).
    "paths": { "@/*": ["./resources/*"] }
  },
  "include": ["src", "resources", "tests", "vite.config.ts"]
}
