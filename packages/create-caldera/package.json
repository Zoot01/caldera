{
  "name": "create-caldera",
  "version": "0.1.0",
  "description": "Create a Caldera app: npm create caldera@latest my-app",
  "type": "module",
  "license": "MIT",
  "homepage": "https://calderajs.dev/docs/installation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoot01/caldera.git",
    "directory": "packages/create-caldera"
  },
  "bugs": "https://github.com/Zoot01/caldera/issues",
  "author": "Zoot01",
  "keywords": [
    "caldera",
    "framework",
    "typescript",
    "hono",
    "laravel"
  ],
  "bin": {
    "create-caldera": "./bin/create-caldera.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "template",
    "template-next",
    "kits",
    "databases"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "citty": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
