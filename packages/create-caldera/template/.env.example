APP_URL=http://localhost:3000
APP_KEY=
DATABASE_URL=file:local.db
# Turso (libsql://…): its auth token.
DATABASE_AUTH_TOKEN=
PORT=3000
# Proxies whose X-Forwarded-For/-Proto to believe: loopback (Caddy/nginx here), addresses, or *
TRUSTED_PROXIES=loopback
# sync runs jobs as they're dispatched. In production use database (jobs in your database) or redis
# (with REDIS_URL), and run `pnpm worker`.
QUEUE_CONNECTION=sync
REDIS_URL=
CRON_SECRET=
# S3-compatible storage; unset keeps files in storage/app
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Realtime: server (caldera dev runs it on BROADCAST_PORT; `pnpm realtime` in production), pusher
# (hosted: PUSHER_APP_ID, PUSHER_KEY, PUSHER_SECRET, PUSHER_CLUSTER), cloudflare (Workers), or log.
BROADCAST_CONNECTION=server
BROADCAST_PORT=6001
BROADCAST_PUBLIC_URL=
# Optional: by default the app and the realtime server derive a shared secret from APP_KEY.
BROADCAST_SECRET=
# Mail: log (default) prints and keeps an outbox at /_caldera/mail/outbox. resend, postmark, ses or smtp send for real.
MAIL_MAILER=log
MAIL_FROM=
MAIL_REDIRECT_TO=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SMTP_URL=
SES_REGION=
