{
  "name": "@caldera/broadcast",
  "version": "0.0.0",
  "description": "Caldera realtime broadcasting: typed channels and events over the pusher protocol (Pusher, Soketi, Reverb, a Cloudflare Durable Object, or its own server).",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./hub": {
      "types": "./dist/hub.d.ts",
      "default": "./dist/hub.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "default": "./dist/redis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@caldera/auth": "workspace:*",
    "@caldera/events": "workspace:*",
    "hono": "^4.13.14",
    "zod": "^4.6.0",
    "pusher-js": "^8.4.0",
    "react": "^19.0.0",
    "ioredis": "^5.4.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@caldera/auth": {
      "optional": true
    },
    "pusher-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera/core": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@caldera/auth": "workspace:*",
    "@caldera/db": "workspace:*",
    "@caldera/events": "workspace:*",
    "@caldera/http": "workspace:*",
    "@caldera/queue": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "@hono/node-server": "^2.1.5",
    "@types/react": "19.3.0",
    "@types/ws": "^8.18.1",
    "drizzle-orm": "1.0.0-rc.5",
    "esbuild": "0.28.2",
    "hono": "^4.13.14",
    "ioredis": "6.0.0",
    "miniflare": "4.20260730.0",
    "pusher-js": "8.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  }
}
