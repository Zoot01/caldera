{
  "name": "@caldera/broadcast",
  "version": "0.0.0",
  "description": "Caldera realtime broadcasting: typed channels and events over the pusher protocol (Pusher, Soketi, Reverb, a Cloudflare Durable Object, or its own server).",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@caldera/auth": "workspace:*",
    "@caldera/events": "workspace:*",
    "hono": "^4.13.14",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@caldera/auth": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera/auth": "workspace:*",
    "@caldera/db": "workspace:*",
    "@caldera/events": "workspace:*",
    "@caldera/http": "workspace:*",
    "@caldera/queue": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.14",
    "pusher-js": "8.6.0",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  }
}
