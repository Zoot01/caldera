{
  "name": "@caldera/i18n",
  "version": "0.0.0",
  "description": "Caldera i18n: typed ICU messages, per-request locales, localized validation errors, and only the messages a page needs on the client.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./icu": {
      "types": "./dist/icu.d.ts",
      "default": "./dist/icu.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lang"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@inertiajs/react": ">=3.0.0",
    "hono": "^4.13.0",
    "react": ">=19.0.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@inertiajs/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera/core": "workspace:*",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "intl-messageformat": "12.1.3"
  },
  "devDependencies": {
    "@caldera/http": "workspace:*",
    "@caldera/inertia": "workspace:*",
    "@inertiajs/react": "3.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "hono": "4.13.14",
    "miniflare": "4.20260730.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  }
}
