{
  "name": "@caldera/cache",
  "version": "0.0.0",
  "description": "Caldera cache: remember, stale-while-revalidate, locks, tags and rate limiting over memory, Redis and edge stores.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "hono": "^4.13.0",
    "ioredis": ">=5.0.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera/http": "workspace:*",
    "hono": "^4.13.14",
    "ioredis": "6.0.0",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  }
}
