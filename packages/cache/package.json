{
  "name": "@caldera/cache",
  "version": "0.0.0",
  "description": "Caldera cache: remember, stale-while-revalidate, locks, tags and rate limiting over memory, Redis and edge stores.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "default": "./dist/redis.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "hono": "^4.13.0",
    "ioredis": ">=5.0.0",
    "zod": "^4.6.0",
    "@caldera/db": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@caldera/db": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera/db": "workspace:*",
    "@caldera/http": "workspace:*",
    "@libsql/client": "0.18.0",
    "@types/pg": "^8.15.0",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.14",
    "ioredis": "6.0.0",
    "miniflare": "4.20260730.0",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  }
}
