{
  "name": "@caldera-js/inertia",
  "version": "0.1.0",
  "description": "Caldera's Inertia adapter: typed pages, shared props, partial reloads and deferred props over Hono, with Vite asset tags.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://calderajs.dev/docs/pages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoot01/caldera.git",
    "directory": "packages/inertia"
  },
  "bugs": "https://github.com/Zoot01/caldera/issues",
  "author": "Zoot01",
  "keywords": [
    "caldera",
    "framework",
    "typescript",
    "hono",
    "laravel",
    "inertia"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "default": "./dist/vite-plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "hono": "^4.13.0",
    "vite": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera-js/core": "workspace:*",
    "@caldera-js/http": "workspace:*"
  },
  "devDependencies": {
    "hono": "^4.13.14",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
