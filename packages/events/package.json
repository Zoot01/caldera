{
  "name": "@caldera/events",
  "version": "0.0.0",
  "description": "Caldera events: typed events, listeners (in-process or queued as jobs), after-commit emits and fakes.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "dependencies": {
    "@caldera/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera/cache": "workspace:*",
    "@caldera/db": "workspace:*",
    "@caldera/queue": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "drizzle-orm": "1.0.0-rc.5",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  }
}
