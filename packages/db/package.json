{
  "name": "@caldera/db",
  "version": "0.0.0",
  "description": "Caldera database layer over Drizzle ORM 1.0: transactions with after-commit hooks, column helpers and models.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "default": "./dist/pg.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./factories": {
      "types": "./dist/factories.d.ts",
      "default": "./dist/factories.js"
    },
    "./seeders": {
      "types": "./dist/seeders.d.ts",
      "default": "./dist/seeders.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@faker-js/faker": "^10.0.0",
    "drizzle-orm": "1.0.0-rc.5",
    "vitest": ">=3.0.0",
    "zod": "^4.6.0"
  },
  "dependencies": {
    "@caldera/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera/http": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "@faker-js/faker": "10.6.0",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.14",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
