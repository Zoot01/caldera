{
  "name": "@caldera-js/next",
  "version": "0.1.0",
  "description": "Caldera in a Next.js app: the app's routes under /api, submit() and load() for server actions and pages, services in Server Components, a typed client.",
  "type": "module",
  "license": "MIT",
  "author": "Zoot01",
  "homepage": "https://calderajs.dev/docs/nextjs",
  "keywords": [
    "caldera",
    "framework",
    "typescript",
    "hono",
    "laravel",
    "next"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "hono": "^4.13.0",
    "next": ">=15.0.0",
    "react": ">=19.0.0"
  },
  "dependencies": {
    "@caldera-js/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera-js/http": "workspace:*",
    "@caldera-js/i18n": "workspace:*",
    "@types/react": "19.3.0",
    "hono": "4.13.14",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
