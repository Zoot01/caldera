{
  "name": "@caldera-js/http",
  "version": "0.1.0",
  "description": "Caldera HTTP layer: named typed routes, request validation, middleware, signed links, trusted proxies, the error envelope and security defaults.",
  "type": "module",
  "license": "MIT",
  "author": "Zoot01",
  "homepage": "https://calderajs.dev/docs/routing",
  "keywords": [
    "caldera",
    "framework",
    "typescript",
    "hono",
    "laravel",
    "http"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "hono": "^4.13.0",
    "zod": "^4.6.0"
  },
  "dependencies": {
    "@caldera-js/core": "workspace:*"
  },
  "devDependencies": {
    "hono": "^4.13.14",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
