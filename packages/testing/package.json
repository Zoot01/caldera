{
  "name": "@caldera-js/testing",
  "version": "0.1.0",
  "description": "Caldera testing: boot the app per test file, a migrated database rolled back per test, self-restoring fakes, and an HTTP client with Laravel-style assertions.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://calderajs.dev/docs/testing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoot01/caldera.git",
    "directory": "packages/testing"
  },
  "bugs": "https://github.com/Zoot01/caldera/issues",
  "author": "Zoot01",
  "keywords": [
    "caldera",
    "framework",
    "typescript",
    "hono",
    "laravel",
    "testing"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "vitest": ">=4.0.0",
    "@caldera-js/db": "workspace:*",
    "@caldera-js/auth": "workspace:*"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "@caldera-js/db": {
      "optional": true
    },
    "@caldera-js/auth": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera-js/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera-js/auth": "workspace:*",
    "@caldera-js/cache": "workspace:*",
    "@caldera-js/db": "workspace:*",
    "@caldera-js/http": "workspace:*",
    "@caldera-js/inertia": "workspace:*",
    "@caldera-js/mail": "workspace:*",
    "@caldera-js/queue": "workspace:*",
    "@libsql/client": "0.18.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.14",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
