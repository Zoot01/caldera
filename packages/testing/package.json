{
  "name": "@caldera/testing",
  "version": "0.0.0",
  "description": "Caldera testing: boot the app per test file, a migrated database rolled back per test, self-restoring fakes, and an HTTP client with Laravel-style assertions.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "vitest": ">=4.0.0",
    "@caldera/db": "workspace:*",
    "@caldera/auth": "workspace:*"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "@caldera/db": {
      "optional": true
    },
    "@caldera/auth": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera/core": "workspace:*"
  },
  "devDependencies": {
    "@caldera/auth": "workspace:*",
    "@caldera/cache": "workspace:*",
    "@caldera/db": "workspace:*",
    "@caldera/http": "workspace:*",
    "@caldera/inertia": "workspace:*",
    "@caldera/mail": "workspace:*",
    "@caldera/queue": "workspace:*",
    "@libsql/client": "0.18.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.14",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  }
}
