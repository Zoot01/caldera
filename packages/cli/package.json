{
  "name": "@caldera-js/cli",
  "version": "0.1.0",
  "description": "The caldera command: the dev server, code generation, generators, migrations, workers, deploy setup and checks, and an MCP server for AI agents.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://calderajs.dev/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoot01/caldera.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/Zoot01/caldera/issues",
  "author": "Zoot01",
  "keywords": [
    "caldera",
    "framework",
    "typescript",
    "hono",
    "laravel"
  ],
  "bin": {
    "caldera": "./bin/caldera.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@caldera-js/auth": "workspace:*",
    "@caldera-js/core": "workspace:*",
    "@caldera-js/db": "workspace:*",
    "@caldera-js/i18n": "workspace:*",
    "citty": "0.2.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@caldera-js/broadcast": "workspace:*",
    "@caldera-js/cache": "workspace:*",
    "@caldera-js/events": "workspace:*",
    "@caldera-js/http": "workspace:*",
    "@caldera-js/inertia": "workspace:*",
    "@caldera-js/mail": "workspace:*",
    "@caldera-js/notifications": "workspace:*",
    "@caldera-js/queue": "workspace:*",
    "@caldera-js/schedule": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "@inertiajs/core": "3.9.1",
    "@inertiajs/react": "3.9.1",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@react-email/components": "1.0.12",
    "@react-email/tailwind": "2.0.7",
    "@types/pg": "^8.15.0",
    "@types/react": "19.3.0",
    "better-auth": "1.7.14",
    "bullmq": "6.5.1",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.14",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
