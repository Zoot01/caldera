{
  "name": "@caldera/cli",
  "version": "0.0.0",
  "description": "The caldera command: code generation, introspection and generators.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "caldera": "./bin/caldera.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@caldera/core": "workspace:*",
    "citty": "0.2.2",
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@caldera/db": "workspace:*",
    "@caldera/http": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.14",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
