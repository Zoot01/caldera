{
  "name": "@caldera-js/schedule",
  "version": "0.1.0",
  "description": "Caldera scheduling: cron schedules that dispatch jobs, run from a worker, OS cron, Cloudflare cron triggers or Vercel Cron.",
  "type": "module",
  "license": "MIT",
  "author": "Zoot01",
  "homepage": "https://calderajs.dev/docs/scheduling",
  "keywords": [
    "caldera",
    "framework",
    "typescript",
    "hono",
    "laravel",
    "schedule"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "hono": "^4.13.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "@caldera-js/core": "workspace:*",
    "@caldera-js/queue": "workspace:*",
    "croner": "10.0.1"
  },
  "devDependencies": {
    "@caldera-js/cache": "workspace:*",
    "hono": "^4.13.14",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
